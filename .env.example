# CacheSense Environment Configuration

# Core Semantic Cache Settings
SIMILARITY_THRESHOLD=0.92
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
SQLITE_DB_PATH=data/cache.db
FAISS_INDEX_PATH=data/faiss.index
MAX_CACHE_ENTRIES=50000
DEFAULT_TTL_SECONDS=86400
MAX_CACHEABLE_TEMPERATURE=0.3
CACHE_NAMESPACE_BY_KEY=false
SINGLE_FLIGHT_ENABLED=true

# Privacy and PII Filters
CACHE_PII_FILTER_ENABLED=true
LOG_RAW_PROMPTS=false

# Concurrency
EMBEDDING_THREADS=4
TTL_SWEEP_INTERVAL_SECONDS=60
SNAPSHOT_INTERVAL_SECONDS=300

# Upstream Provider Configuration
UPSTREAM_OPENAI_BASE_URL=https://api.openai.com/v1
UPSTREAM_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
UPSTREAM_TIMEOUT_SECONDS=60.0
UPSTREAM_MAX_RETRIES=2

# Mock Upstream (for zero-cost local testing and benchmarks)
MOCK_UPSTREAM_ENABLED=false
MOCK_UPSTREAM_BASE_URL=http://127.0.0.1:8080

# Gateway Server
HOST=0.0.0.0
PORT=8000
